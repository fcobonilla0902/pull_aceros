  "components": {
    "schemas": {
      "ActionInput": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "action": {
            "type": "string",
            "enum": [
              "validate",
              "assign",
              "prepare",
              "ready",
              "transport",
              "deliver",
              "incident",
              "resolve",
              "edit",
              "cancel"
            ],
            "title": "Action"
          },
          "operator_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operator Id"
          },
          "forklift_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
